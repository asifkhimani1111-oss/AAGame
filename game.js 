
const KEY = 'aagame_data_v1';

let data = {
  coins: 1000,
  name: 'અયાન શેઠ',
  lastBonus: '',
  sound: true,
  unlocked: []
};

function loadData() {
  try {
    const saved = localStorage.getItem(KEY);
    if (saved) data = { ...data, ...JSON.parse(saved) };
  } catch (e) {}
  updateUI();
}

function saveData() {
  try {
    localStorage.setItem(KEY, JSON.stringify(data));
  } catch (e) {}
  updateUI();
}

function updateUI() {
  document.getElementById('coinCount').textContent = data.coins;
  document.getElementById('headerName').textContent = data.name;
  document.getElementById('nameInput').value = data.name;
  document.getElementById('soundButton').textContent =
    'Sound: ' + (data.sound ? 'ON' : 'OFF');

  const today = new Date().toLocaleDateString('en-CA');
  const claimed = data.lastBonus === today;

  const bonus = document.getElementById('bonusButton');
  bonus.disabled = claimed;
  bonus.textContent = claimed ? 'આજનો બોનસ મળી ગયો' : '+250 Coins મેળવો';

  document.getElementById('bonusMessage').textContent =
    claimed ? 'આજે તમે બોનસ મેળવી લીધો છે.' : 'આજે તમારો બોનસ મેળવો!';

  renderStore();
}

function showPage(id, button) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById(id).classList.add('active');

  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
  button.classList.add('active');
}

function claimBonus() {
  const today = new Date().toLocaleDateString('en-CA');
  if (data.lastBonus === today) return;
  data.coins += 250;
  data.lastBonus = today;
  saveData();
}

function saveName() {
  const name = document.getElementById('nameInput').value.trim();
  if (!name) {
    alert('કૃપા કરીને નામ લખો.');
    return;
  }
  data.name = name;
  saveData();
  alert('નામ સેવ થઈ ગયું!');
}

function toggleSound() {
  data.sound = !data.sound;
  saveData();
}

const gameModal = document.getElementById('gameModal');
const modalBox = gameModal.querySelector('.modal-box');

let bottles = [];
let selectedBottle = -1;
let bottleMoves = 0;
let bottleLevel = 1;

function addGameStyles() {
  if (document.getElementById('extraGameStyles')) return;

  const style = document.createElement('style');
  style.id = 'extraGameStyles';
  style.textContent = `
    #gamePlayArea { margin-top:15px; }
    .bottle-board {
      display:flex; justify-content:center; align-items:flex-end;
      gap:15px; flex-wrap:wrap; padding:20px 5px;
      min-height:180px;
    }
    .bottle {
      width:48px; height:145px; border:3px solid #cbd5ff;
      border-top:0; border-radius:0 0 15px 15px;
      background:#11182e; display:flex; flex-direction:column-reverse;
      overflow:hidden; padding:3px; cursor:pointer;
    }
    .bottle.selected {
      border-color:#ffd65a; transform:translateY(-10px);
    }
    .water {
      width:100%; height:25%; border-radius:4px; flex-shrink:0;
    }
    .game-controls {
      display:flex; gap:10px; justify-content:center; flex-wrap:wrap;
      margin:12px 0;
    }
    .game-status {
      text-align:center; color:#ffd65a; min-height:25px;
      margin:10px 0;
    }
  `;
  document.head.appendChild(style);
}

function openGame(name, emoji, description) {
  document.getElementById('gameTitle').textContent = name;
  document.getElementById('gameEmoji').textContent = emoji;
  document.getElementById('gameDescription').textContent = description;

  const notice = modalBox.querySelector('.notice');
  const oldArea = document.getElementById('gamePlayArea');
  if (oldArea) oldArea.remove();

  if (notice) notice.style.display = 'none';

  if (name === 'Bottle Colour') {
    addGameStyles();

    const area = document.createElement('div');
    area.id = 'gamePlayArea';
    modalBox.insertBefore(area, modalBox.querySelector('br'));
    startBottleGame();
  } else {
    if (notice) {
      notice.style.display = 'block';
      notice.textContent =
        'આ ગેમનું Gameplay હજી બનાવવાનું બાકી છે. અત્યારે Bottle Colour રમી શકો છો.';
    }
  }

  gameModal.style.display = 'flex';
}

function startBottleGame() {
  bottles = [
    ['red', 'blue', 'red', 'blue'],
    ['blue', 'red', 'blue', 'red'],
    []
  ];

  selectedBottle = -1;
  bottleMoves = 0;
  drawBottleGame();
}

function drawBottleGame() {
  const area = document.getElementById('gamePlayArea');
  if (!area) return;

  area.innerHTML = `
    <p class="small" style="text-align:center">
      Level ${bottleLevel} · Moves: ${bottleMoves}
    </p>
    <p class="small" style="text-align:center">
      એક બોટલ પસંદ કરો, પછી બીજી બોટલ પસંદ કરો.
    </p>
    <div class="bottle-board" id="bottleBoard"></div>
    <div class="game-status" id="bottleStatus">
      રંગોને અલગ બોટલમાં ગોઠવો.
    </div>
    <div class="game-controls">
      <button id="restartBottle">ફરીથી રમો</button>
    </div>
  `;

  const board = document.getElementById('bottleBoard');

  bottles.forEach((bottle, index) => {
    const bottleEl = document.createElement('div');
    bottleEl.className = 'bottle' +
      (selectedBottle === index ? ' selected' : '');

    bottle.forEach(color => {
      const water = document.createElement('div');
      water.className = 'water';
      water.style.background = color;
      bottleEl.appendChild(water);
    });

    bottleEl.onclick = () => selectBottle(index);
    board.appendChild(bottleEl);
  });

  document.getElementById('restartBottle').onclick = startBottleGame;
}

function selectBottle(index) {
  const status = document.getElementById('bottleStatus');

  if (selectedBottle === -1) {
    if (bottles[index].length === 0) {
      status.textContent = 'પહેલા પાણીવાળી બોટલ પસંદ કરો.';
      return;
    }
    selectedBottle = index;
    status.textContent = 'હવે પાણી નાખવાની બીજી બોટલ પસંદ કરો.';
    drawBottleGame();
    return;
  }

  if (selectedBottle === index) {
    selectedBottle = -1;
    drawBottleGame();
    return;
  }

  const source = bottles[selectedBottle];
  const target = bottles[index];

  if (target.length >= 4) {
    status.textContent = 'આ બોટલ ભરેલી છે.';
    return;
  }

  const color = source[source.length - 1];

  if (target.length > 0 && target[target.length - 1] !== color) {
    status.textContent = 'અલગ રંગમાં પાણી નાખી શકાતું નથી.';
    return;
  }

  let count = 0;
  while (
    source.length > 0 &&
    source[source.length - 1] === color &&
    target.length < 4
  ) {
    target.push(source.pop());
    count++;
  }

  bottleMoves++;
  selectedBottle = -1;

  if (checkBottleWin()) {
    drawBottleGame();
    document.getElementById('bottleStatus').textContent =
      'શાબાશ! Level પૂર્ણ થયું! 🎉';
    return;
  }

  drawBottleGame();
}

function checkBottleWin() {
  return bottles.every(bottle =>
    bottle.length === 0 ||
    (bottle.length === 4 && bottle.every(c => c === bottle[0]))
  );
}

function closeGame() {
  gameModal.style.display = 'none';
  const notice = modalBox.querySelector('.notice');
  if (notice) notice.style.display = 'block';
  const area = document.getElementById('gamePlayArea');
  if (area) area.remove();
}

const items = [
  { id: 'car', name: 'Golden Racer Car', emoji: '🏎️', price: 300 },
  { id: 'bike', name: 'Neon Cyber Bike', emoji: '🏍️', price: 300 },
  { id: 'striker', name: 'Royal Striker', emoji: '⚫', price: 200 },
  { id: 'dice', name: 'Golden Dice', emoji: '🎲', price: 200 }
];

function renderStore() {
  const box = document.getElementById('storeItems');
  box.innerHTML = '';

  items.forEach(item => {
    const unlocked = data.unlocked.includes(item.id);
    const div = document.createElement('div');
    div.className = 'item';

    const info = document.createElement('div');
    info.textContent = item.emoji + ' ' + item.name;

    const btn = document.createElement('button');
    btn.textContent = unlocked ? 'Unlocked' : item.price + ' Coins';
    btn.disabled = unlocked;
    btn.onclick = () => buyItem(item.id);

    div.append(info, btn);
    box.appendChild(div);
  });
}

function buyItem(id) {
  const item = items.find(x => x.id === id);
  if (!item || data.unlocked.includes(id)) return;

  if (data.coins < item.price) {
    alert('તમારી પાસે પૂરતા Coins નથી.');
    return;
  }

  if (!confirm(item.name + ' અનલોક કરવું છે?')) return;

  data.coins -= item.price;
  data.unlocked.push(id);
  saveData();
  alert('આઇટમ અનલોક થઈ ગઈ!');
}

window.showPage = showPage;
window.claimBonus = claimBonus;
window.saveName = saveName;
window.toggleSound = toggleSound;
window.openGame = openGame;
window.closeGame = closeGame;

loadData();
