
*{box-sizing:border-box}

body{
 margin:0;
 background:#101326;
 color:white;
 font-family:Arial,sans-serif;
 padding-bottom:85px
}

header{
 padding:18px 15px;
 background:linear-gradient(120deg,#242b55,#151a36);
 display:flex;
 justify-content:space-between;
 align-items:center;
 border-bottom:1px solid #343b69
}

.logo{
 font-size:24px;
 font-weight:bold;
 color:#ffd65a
}

.profile{
 font-size:12px;
 color:#cbd0ee;
 text-align:right
}

.profile strong{
 display:block;
 font-size:15px;
 color:white
}

.container{
 padding:15px;
 max-width:850px;
 margin:auto
}

h2{
 font-size:20px;
 margin:12px 0
}

h3{margin:8px 0}

.small{
 color:#aeb5d7;
 font-size:13px
}

.stats{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
 margin:15px 0
}

.stat,.card,.panel{
 background:#1b2141;
 border:1px solid #343b69;
 border-radius:15px;
 padding:15px
}

.stat strong{
 font-size:20px;
 color:#ffd65a
}

.games{
 display:grid;
 grid-template-columns:repeat(2,minmax(0,1fr));
 gap:12px
}

.game{
 background:linear-gradient(145deg,#252d59,#1a2040);
 border:1px solid #3b467d;
 border-radius:16px;
 padding:15px 10px;
 text-align:center;
 min-height:145px;
 cursor:pointer
}

.game:active{transform:scale(.97)}

.game .emoji{font-size:38px}

.game h3{font-size:15px}

.game p{
 font-size:12px;
 color:#bdc5e8;
 margin:5px 0
}

.featured{
 grid-column:1/-1;
 background:linear-gradient(120deg,#473018,#282044);
 border-color:#9b7139
}

button{
 border:0;
 border-radius:10px;
 padding:11px 15px;
 background:#ffd65a;
 color:#19172b;
 font-weight:bold;
 cursor:pointer
}

button.secondary{
 background:#343d70;
 color:white
}

button:disabled{opacity:.5}

nav{
 position:fixed;
 bottom:0;
 left:0;
 right:0;
 background:#171c37;
 border-top:1px solid #343b69;
 display:flex;
 justify-content:space-around;
 padding:10px 3px;
 z-index:5
}

nav button{
 background:transparent;
 color:#c5cbea;
 padding:7px 5px;
 font-size:12px
}

nav button.active{color:#ffd65a}

.page{display:none}

.page.active{display:block}

.modal{
 display:none;
 position:fixed;
 inset:0;
 background:#000b;
 z-index:10;
 align-items:center;
 justify-content:center;
 padding:18px
}

.modal-box{
 background:#20274b;
 border:1px solid #58639c;
 border-radius:18px;
 padding:20px;
 width:100%;
 max-width:420px;
 max-height:85vh;
 overflow:auto
}

.modal-box h2{margin-top:0}

input{
 width:100%;
 padding:12px;
 border-radius:9px;
 border:1px solid #56608e;
 background:#10162f;
 color:white;
 margin:8px 0
}

.item{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:10px;
 padding:12px 0;
 border-bottom:1px solid #343b69
}

.notice{
 background:#292f53;
 border-radius:10px;
 padding:12px;
 color:#d9def6;
 font-size:13px;
 line-height:1.6
}

footer{
 text-align:center;
 color:#8992bd;
 font-size:12px;
 padding:20px
}

@media(min-width:600px){
 .games{grid-template-columns:repeat(3,minmax(0,1fr))}
}
